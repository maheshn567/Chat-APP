// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}



//model for user
model User {
    id          String    @id @default(uuid())
    username    String    @unique
    email       String    @unique
    password    String
    chats       Chat[]    @relation("CreatedChats") // chats this user created (admin)
    joinedChats Chat[]    @relation("ChatMembers")  // group/chat members relation
    messages    Message[] // messages this user sent
    createdAt   DateTime  @default(now())
    updatedAt   DateTime  @updatedAt
    lastSeen    DateTime  @default(now())
    reactions   Reaction[] // reactions this user added
}

// model for Chat (a chat room/conversation)
model Chat {
    id         String    @id @default(uuid())
    isGroup    Boolean   @default(false)
    name       String?                             // group name
    userId     String                              // scalar FK — stores the User's id
    user       User      @relation("CreatedChats", fields: [userId], references: [id])
    receiverId String?                             // receiver's user ID for private chats
    members    User[]    @relation("ChatMembers")  // users belonging to this chat/group
    messages   Message[]
    createdAt  DateTime  @default(now())
    updatedAt  DateTime  @updatedAt
}

// model for Message (a single message inside a chat)
model Message {
    id        String   @id @default(uuid())
    text      String
    chatId    String                              // scalar FK — stores the Chat's id
    chat      Chat     @relation(fields: [chatId], references: [id])
    userId    String                              // scalar FK — stores the sender's id
    user      User     @relation(fields: [userId], references: [id])
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
    status    String   @default("sent")
    reactions Reaction[] // reactions on this message
}

// model for Message Reactions
model Reaction {
    id        String   @id @default(uuid())
    emoji     String
    messageId String
    message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
    userId    String
    user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
    createdAt DateTime @default(now())

    @@unique([messageId, userId, emoji])
}
